# Server-only Groq key (never prefix with VITE_)
GROQ_API_KEY=gsk_your_key_here

# Microsoft sign-in (SPA public client ID)
# Azure Portal → App registrations → SPA redirect URIs:
# http://localhost:5173 and https://nlog.kaila-app.com
VITE_MSAL_CLIENT_ID=

# Email/password auth (required for non-Microsoft register/login)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NLOG_AUTH_SECRET=

# Optional invite code required to register
# NLOG_REGISTER_CODE=your-private-invite

# Optional bootstrap users (login only, no register needed): email:password,email2:pass2
# NLOG_PASSWORD_USERS=you@example.com:changeme

# Optional: comma-separated emails allowed (Microsoft + password)
# NLOG_ALLOWED_EMAILS=you@outlook.com,partner@example.com

# Production register/login persistence (Upstash Redis free tier)
# Required for Create account in production — local uses data/users.json automatically
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password reset via Brevo (https://app.brevo.com)
# Sender must be verified in Brevo → Senders & Domains
BREVO_API_KEY=
# Either combined:
# NLOG_FROM_EMAIL=NLog <no-reply@kaila-app.com>
# Or split:
# MAIL_FROM_NAME=NLog
# MAIL_FROM_ADDRESS=no-reply@kaila-app.com
NLOG_FROM_EMAIL=
NLOG_APP_URL=https://nlog.kaila-app.com

# Slack check-in posting (server-only — posts from NLog Check-in tab)
SLACK_BOT_TOKEN=
# Output Reporting Channel
SLACK_CHECKIN_CHANNEL_ID=C0BKZQLL8HL
# Your Slack member ID (for post confirmations / future @mentions)
NLOG_SLACK_USER_ID=U0BA02D032S
